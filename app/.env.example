# Required: replace this with a long random value before starting the app.
SECRET_KEY=replace-with-a-long-random-value

# Optional: required only for Live Colab API Tunnel mode.
MEDGEMMA_API_URL=
MEDGEMMA_API_KEY=
MEDGEMMA_API_TIMEOUT=600

# Optional: host port exposed by Docker Compose.
APP_PORT=5000

# Optional: Gunicorn process tuning. Its timeout otherwise follows
# MEDGEMMA_API_TIMEOUT plus 60 seconds.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=
